{
    "name": "alcedocore-admin",
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "prebuild": "mkdir -p .tmp-pwa && cp -r public/manifest.json public/sw.js public/icons .tmp-pwa/ 2>/dev/null || true",
        "postbuild": "cp -r .tmp-pwa/* public/ 2>/dev/null; rm -rf .tmp-pwa || true",
        "preview": "vite preview",
        "test": "vitest",
        "test:coverage": "vitest --coverage",
        "build-docker-dev": "npm run build && rm -rf ../../.docker-plugins/admin/public/ && mkdir -p ../../.docker-plugins/admin/public/ && cp -r public/* ../../.docker-plugins/admin/public/"
    },
    "dependencies": {
        "@primevue/themes": "^4.5.4",
        "alcedocore-sdk-node": "file:../../sdk/alcedocore-sdk-node/src",
        "chart.js": "^4.5.1",
        "dompurify": "^3.4.13",
        "highlight.js": "^11.11.1",
        "marked": "^18.0.9",
        "mermaid": "^11.16.1",
        "pinia": "^4.0.2",
        "primeicons": "^8.0.0",
        "primevue": "^5.0.0",
        "swagger-ui-dist": "^5.32.12",
        "vue": "^3.5.41",
        "vue-router": "^5.2.0",
        "vuedraggable": "^4.1.0"
    },
    "devDependencies": {
        "@fontsource/inter": "^5.3.0",
        "@fontsource/material-symbols-outlined": "^5.3.2",
        "@primevue/themes": "^4.5.4",
        "@tailwindcss/vite": "^4.3.3",
        "@types/dompurify": "^3.2.0",
        "@types/node": "^26.1.2",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vitest/browser": "^4.1.10",
        "@vue/test-utils": "^2.4.11",
        "alcedocore-sdk-node": "file:../../sdk/alcedocore-sdk-node/src",
        "chart.js": "^4.5.1",
        "dompurify": "^3.4.13",
        "eslint": "^10.8.0",
        "highlight.js": "^11.11.1",
        "jsdom": "^30.0.1",
        "marked": "^18.0.9",
        "mermaid": "^11.16.1",
        "pinia": "^4.0.2",
        "primeicons": "^8.0.0",
        "primevue": "^5.0.0",
        "swagger-ui-dist": "^5.32.12",
        "unplugin-vue-components": "^32.1.0",
        "vite": "^8.2.1",
        "vitest": "^4.1.10",
        "vue": "^3.5.41",
        "vue-router": "^5.2.0",
        "vue-tsc": "^3.3.9",
        "vuedraggable": "^4.1.0"
    }
}
