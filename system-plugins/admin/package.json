{
    "name": "alcedocore-admin",
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "prebuild": "mkdir -p .tmp-pwa && cp -r public/manifest.json public/sw.js public/icons .tmp-pwa/ 2>/dev/null || true",
        "postbuild": "cp -r .tmp-pwa/* public/ 2>/dev/null; rm -rf .tmp-pwa || true",
        "preview": "vite preview",
        "test": "vitest",
        "test:coverage": "vitest --coverage",
        "build-docker-dev": "npm run build && rm -rf ../../.docker-plugins/admin/public/ && mkdir -p ../../.docker-plugins/admin/public/ && cp -r public/* ../../.docker-plugins/admin/public/"
    },
    "dependencies": {
        "@primevue/themes": "^4.5.4",
        "alcedo-sdk": "file:../../sdk/alcedo-sdk",
        "chart.js": "^4.5.1",
        "dompurify": "^3.1.0",
        "highlight.js": "^11.10.0",
        "marked": "^12.0.0",
        "mermaid": "^11.15.0",
        "pinia": "^3.0.4",
        "primeicons": "^7.0.0",
        "primevue": "^4.5.5",
        "swagger-ui-dist": "^5.32.6",
        "vue": "^3.4.0",
        "vue-router": "^4.2.0",
        "vuedraggable": "^4.1.0"
    },
    "devDependencies": {
        "@fontsource/inter": "^5.0.0",
        "@fontsource/material-symbols-outlined": "^5.0.0",
        "@tailwindcss/vite": "^4.0.0",
        "@types/dompurify": "^3.0.5",
        "@types/node": "^25.6.0",
        "@vitejs/plugin-vue": "^5.0.0",
        "@vitest/browser": "^2.0.0",
        "@vue/test-utils": "^2.4.0",
        "eslint": "^10.2.1",
        "jsdom": "^24.0.0",
        "unplugin-vue-components": "^32.1.0",
        "vite": "^5.0.0",
        "vitest": "^2.0.0",
        "vue-tsc": "^2.2.12"
    }
}
