DATABASE_URL=postgres://postgres:postgres@localhost:5432/plugin_core
REDIS_URL=redis://localhost:6379
# Optional: use a separate Redis DB/instance for the KV endpoints.
# REDIS_URL_KV=redis://localhost:6379/1
CORE_PORT=8080
SESSION_TTL_SECONDS=604800
RUST_LOG=info
LOCAL_REGISTRY_URL=localhost:5000

REGISTRY_NAME=my-registry
REGISTRY_URL=http://localhost:5000
REGISTRY_PULL_URL=localhost:5000
REGISTRY_AUTH_TYPE=none
REGISTRY_USERNAME=
REGISTRY_PASSWORD=

ADMIN_EMAIL=admin@alcedo.dev
ADMIN_PASSWORD=admin123!
PLUGIN_NETWORK=alcedocore_plugins
PLUGIN_PORT=8080
PLUGIN_CORE_URL=http://core:8080
# Deployment backend: `mock` (default, no containers) or `docker`, which needs
# `--features docker` and an active Swarm with an overlay `PLUGIN_NETWORK`.
# Startup fails fast if the daemon is unreachable or Swarm is not initialized.
PLUGIN_PLATFORM=mock
PLUGINS_DIR=./.plugins
COLLECTION_LOG_FLUSH_MS=100
SECURITY_COOKIE_SECURE=false
SECURITY_COOKIE_SAMESITE=lax
SECURITY_COOKIE_HTTP_ONLY=true
SECURITY_COOKIE_NAME=alcedo_session
SECURITY_COOKIE_PATH=/
SECURITY_COOKIE_DOMAIN=
SECURITY_CORS_ENABLED=true
SECURITY_CORS_ORIGINS=*
CORS_ORIGINS=http://localhost:8080
SECURITY_RATE_LIMIT_ENABLED=true
SECURITY_RATE_LIMIT_REQUESTS=200
SECURITY_RATE_LIMIT_WINDOW=60
RATE_LIMIT_AUTH_REQUESTS=100
RATE_LIMIT_AUTH_WINDOW=60
RATE_LIMIT_API_REQUESTS=1000
RATE_LIMIT_API_WINDOW=60
SECURITY_PASSWORD_MIN_LENGTH=8
SECURITY_SESSION_FIXATION=true
SYSTEM_PLUGINS_URL=http://localhost:9090
REGISTRY_ENCRYPTION_KEY=UuG5d1HEJuBH0tElr6R4I3deq/BabTiHhfByFS9xom4=
FILE_STORAGE_PROVIDER=local
FILES_DIR=./files
# S3_BUCKET=
# S3_PREFIX=
MAX_REQUEST_BODY_SIZE=10485760
CONTENT_SECURITY_POLICY=default-src 'self'
EVENT_FORWARDER_MAX_CONCURRENT=50
DOCKER_SOCKET=/var/run/docker.sock
CORE_MIGRATIONS_DIR=./core-migrations
DEV_PLUGIN_PORT=8000
DEV_MODE=false
DEV_CORE_IP="[local ip]"