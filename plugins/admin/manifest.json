{
  "name": "admin",
  "version": "0.1.0",
  "display_name": "System Admin",
  "description": "Admin dashboard for managing plugins, viewing system health, and monitoring deployments",
  "public_folder": "public",
  "plugin_type": "static",
  "system_plugin": true,
  "author": "Plugin Core Team",
  "homepage": "",
  "license": "MIT",
  "tags": ["admin", "system", "management"],
  "icon": "",
  "pages": [
    {"path": "/sample", "label": "Sample Page", "icon": "page", "sidebar": true}
  ],
  "endpoints": [
    {
      "method": "GET",
      "path": "/api/admin/plugins/list",
      "description": "List all plugins",
      "group": "plugins"
    },
    {
      "method": "GET",
      "path": "/api/admin/plugins/:slug",
      "description": "Get plugin details",
      "group": "plugins"
    }
  ],
  "documentation": [
    {
      "title": "Getting Started",
      "path": "docs/getting-started.md"
    }
  ],
  "settings_schema": {
    "type": "object",
    "properties": {
      "theme": {
        "type": "string",
        "enum": ["light", "dark"],
        "default": "dark",
        "description": "UI theme"
      },
      "refreshInterval": {
        "type": "integer",
        "default": 30,
        "description": "Auto-refresh interval in seconds"
      }
    }
  },
  "settings": {
    "theme": "dark",
    "refreshInterval": 30
  }
}
